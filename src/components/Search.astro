<button class="search-trigger" type="button" data-search-open aria-label="搜索文档">
  <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
  <span>搜索文档、命令、错误码…</span>
  <kbd><span>⌘</span>K</kbd>
</button>

<dialog class="search-dialog" data-search-dialog aria-label="搜索文档">
  <div class="search-dialog__panel">
    <div class="search-dialog__field">
      <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
      <input type="search" placeholder="搜索标题或正文…" data-search-input autocomplete="off" />
      <button type="button" data-search-close aria-label="关闭搜索">Esc</button>
    </div>
    <div class="search-dialog__status" data-search-status>输入关键词开始搜索</div>
    <ul class="search-results" data-search-results></ul>
  </div>
</dialog>

<script>
  interface SearchDocument {
    body: string;
    description: string;
    href: string;
    title: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLUListElement>('[data-search-results]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  let documents: SearchDocument[] | null = null;

  const normalize = (value: string) => value.toLocaleLowerCase('zh-CN');

  const loadDocuments = async () => {
    if (documents) return documents;
    const response = await fetch('/search-index.json');
    documents = await response.json();
    return documents ?? [];
  };

  const openSearch = async () => {
    if (!dialog || !input) return;
    if (!dialog.open) dialog.showModal();
    input.focus();
    await loadDocuments();
  };

  const closeSearch = () => dialog?.close();

  const renderResults = async () => {
    if (!input || !results || !status) return;
    const query = normalize(input.value.trim());
    results.replaceChildren();

    if (!query) {
      status.textContent = '输入关键词开始搜索';
      return;
    }

    const items = (await loadDocuments())
      .map((document) => {
        const title = normalize(document.title);
        const description = normalize(document.description);
        const body = normalize(document.body);
        const score = title === query ? 100 : title.includes(query) ? 50 : description.includes(query) ? 20 : body.includes(query) ? 10 : 0;
        return { document, score };
      })
      .filter((item) => item.score > 0)
      .sort((left, right) => right.score - left.score)
      .slice(0, 8);

    status.textContent = items.length > 0 ? `找到 ${items.length} 篇相关文档` : '没有找到相关内容';

    for (const { document: searchDocument } of items) {
      const listItem = document.createElement('li');
      const link = document.createElement('a');
      const title = document.createElement('strong');
      const description = document.createElement('span');
      link.href = searchDocument.href;
      title.textContent = searchDocument.title;
      description.textContent = searchDocument.description || '打开文档';
      link.append(title, description);
      listItem.append(link);
      results.append(listItem);
    }
  };

  document.querySelector('[data-search-open]')?.addEventListener('click', openSearch);
  document.querySelector('[data-search-close]')?.addEventListener('click', closeSearch);
  input?.addEventListener('input', renderResults);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeSearch();
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
  });
</script>
