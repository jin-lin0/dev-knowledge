<button class="theme-toggle" type="button" data-theme-toggle aria-label="切换颜色主题">
  <i class="ph ph-sun theme-toggle__sun" aria-hidden="true"></i>
  <i class="ph ph-moon theme-toggle__moon" aria-hidden="true"></i>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem('dev-knowledge-theme', nextTheme);
  });
</script>
