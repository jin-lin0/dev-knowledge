---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import { getDocHref } from '../lib/docs';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  return docs.map((entry) => {
    const path = getDocHref(entry.id);
    return {
      params: { slug: path === '/' ? undefined : path.slice(1, -1) },
      props: { entryId: entry.id },
    };
  });
}

const { entryId } = Astro.props;
const docs = await getCollection('docs', ({ data }) => !data.draft);
const entry = docs.find((candidate) => candidate.id === entryId);
if (!entry) throw new Error(`Document not found: ${entryId}`);

const { Content, headings } = await render(entry);
const currentPath = getDocHref(entry.id);
---

<DocsLayout entry={entry} docs={docs} headings={headings} currentPath={currentPath}>
  <Content />
</DocsLayout>
